<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Specialty List View -->
    <record id="view_clinic_specialty_list" model="ir.ui.view">
        <field name="name">clinic.specialty.list</field>
        <field name="model">clinic.specialty</field>
        <field name="arch" type="xml">
            <list string="Specialties">
                <field name="name"/>
                <field name="description"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Specialty Form View -->
    <record id="view_clinic_specialty_form" model="ir.ui.view">
        <field name="name">clinic.specialty.form</field>
        <field name="model">clinic.specialty</field>
        <field name="arch" type="xml">
            <form string="Specialty">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Specialty Search View -->
    <record id="view_clinic_specialty_search" model="ir.ui.view">
        <field name="name">clinic.specialty.search</field>
        <field name="model">clinic.specialty</field>
        <field name="arch" type="xml">
            <search string="Search Specialties">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

</odoo>

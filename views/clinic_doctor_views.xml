<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Doctor List View -->
    <record id="view_clinic_doctor_list" model="ir.ui.view">
        <field name="name">clinic.doctor.list</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="name"/>
                <field name="specialty_id"/>
                <field name="license_number"/>
                <field name="consultation_fee"/>
            </list>
        </field>
    </record>

    <!-- Doctor Form View -->
    <record id="view_clinic_doctor_form" model="ir.ui.view">
        <field name="name">clinic.doctor.form</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <header>
                    <!-- 
                        PHASE 6: DIRECT PRINT DAILY SCHEDULE BUTTON
                        Allows clinic managers and receptionists to generate and download
                        the doctor's appointment schedule PDF with a single click!
                    -->
                    <button name="%(clinic_management.action_report_doctor_schedule)d"
                            string="Print Daily Schedule"
                            type="action"
                            class="btn-primary"
                            icon="fa-print"/>
                </header>
                <sheet>
                    <!-- 
                        PHASE 4: DOCTOR SMART BUTTONS
                        Displays live counters for total appointments and consultations.
                        Clicking either button opens a pre-filtered list view.
                    -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_appointments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>
                        <button name="action_view_consultations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-md">
                            <field name="consultation_count" widget="statinfo" string="Consultations"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="work_email" string="Work Email" required="1"/>
                            <field name="work_phone" string="Work Phone"/>
                            <field name="specialty_id"/>
                            <field name="license_number"/>
                            <field name="user_id" string="Related User" groups="clinic_management.group_clinic_manager"/>
                        </group>
                        <group>
                            <field name="consultation_fee"/>
                            <field name="currency_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="biography"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Doctor Search View -->
    <record id="view_clinic_doctor_search" model="ir.ui.view">
        <field name="name">clinic.doctor.search</field>
        <field name="model">clinic.doctor</field>
        <field name="arch" type="xml">
            <search string="Search Doctors">
                <field name="name"/>
                <field name="license_number"/>
                <field name="specialty_id"/>
                <separator/>
                <filter string="Has Specialty" name="has_specialty"
                        domain="[('specialty_id', '!=', False)]"/>
            </search>
        </field>
    </record>

</odoo>

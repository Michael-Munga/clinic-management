<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action for Patients -->
    <record id="action_clinic_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clinic.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Action for Doctors -->
    <record id="action_clinic_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">clinic.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Action for Specialties -->
    <record id="action_clinic_specialty" model="ir.actions.act_window">
        <field name="name">Specialties</field>
        <field name="res_model">clinic.specialty</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Action for Appointments -->
    <record id="action_clinic_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">clinic.appointment</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No appointments booked yet!
            </p>
            <p>
                Click New to schedule an appointment for a patient.
            </p>
        </field>
    </record>

    <!-- Action for Consultations -->
    <record id="action_clinic_consultation" model="ir.actions.act_window">
        <field name="name">Consultations</field>
        <field name="res_model">clinic.consultation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No consultations recorded yet!
            </p>
        </field>
    </record>

    <!-- Action for Prescriptions -->
    <record id="action_clinic_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">clinic.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No prescriptions created yet!
            </p>
        </field>
    </record>

</odoo>

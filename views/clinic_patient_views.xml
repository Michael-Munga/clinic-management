<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Patient List View -->
    <record id="view_clinic_patient_list" model="ir.ui.view">
        <field name="name">clinic.patient.list</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="name"/>
                <field name="patient_code"/>
                <field name="birthdate"/>
                <field name="age"/>
                <field name="blood_type"/>
            </list>
        </field>
    </record>

    <!-- Patient Form View -->
    <record id="view_clinic_patient_form" model="ir.ui.view">
        <field name="name">clinic.patient.form</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <!-- 
                        ================================================================
                        PHASE 4: SMART BUTTON CONTAINER (oe_button_box)
                        ================================================================
                        - class="oe_button_box": Standard Odoo CSS that floats stat buttons 
                          to the top-right corner of the sheet card.
                        - name="button_box": Mandatory identifier for Odoo's web client.
                    -->
                    <div class="oe_button_box" name="button_box">
                        <!-- 
                            Appointments Stat Button:
                            - type="object": Tells Odoo to call a Python method on the model.
                            - name="action_view_appointments": Calls def action_view_appointments(self).
                            - class="oe_stat_button": Renders as a clickable square stat block with hover effect.
                            - icon="fa-calendar": FontAwesome icon displayed on the left of the button.
                            - widget="statinfo": Formats the field so the number is displayed bold on top
                              and the 'string' label is displayed in smaller text underneath.
                        -->
                        <button name="action_view_appointments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="appointment_count" widget="statinfo" string="Appointments"/>
                        </button>

                        <!-- Prescriptions Stat Button -->
                        <button name="action_view_prescriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                            <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_code"/>
                            <field name="birthdate"/>
                            <field name="age"/>
                        </group>
                        <group>
                            <field name="blood_type"/>
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                    <group>
                        <field name="allergies"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Patient Search View -->
    <record id="view_clinic_patient_search" model="ir.ui.view">
        <field name="name">clinic.patient.search</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name"/>
                <field name="patient_code"/>
                <field name="blood_type"/>
                <separator/>
                <filter string="Has Allergies" name="has_allergies"
                        domain="[('allergies', '!=', False)]"/>
            </search>
        </field>
    </record>

</odoo>
